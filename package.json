{
  "name": "cotizador",
  "private": true,
  "type": "module",
  "scripts": {
    "build:sdk": "node scripts/bundle-sdk.mjs",
    "build": "npm run build:sdk && node scripts/build.mjs",
    "test": "node --test tests/*.test.js tests/cloud.test.mjs tests/sync.test.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cotizador-sync \"node --test tests/firestore-rules.test.mjs\""
  },
  "dependencies": {
    "firebase": "13.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "esbuild": "0.28.2"
  }
}
